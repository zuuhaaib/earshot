# Copy this file to .env and fill it in, then restart `npx expo start`.
# Everything named EXPO_PUBLIC_ is built into the app and readable by anyone who has it,
# so only public values belong here. Never a Supabase secret key (sb_secret_... or
# service_role), the database password or the Spotify client secret.

# Supabase: Project Settings -> API. Leave both empty to keep everything on the phone.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Spotify: the Client ID from developer.spotify.com/dashboard. Leave empty to hide Spotify.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Last.fm API key. Only for running with no backend: with Supabase in use the key lives on the server
# (see supabase/functions/lastfm), and this should be left empty so it never ships in the app.
EXPO_PUBLIC_LASTFM_API_KEY=
