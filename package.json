  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "seed:tracks": "node scripts/fetch-seed-tracks.mjs",
    "assets": "node scripts/make-assets.mjs",
    "test": "jest && node --test supabase/tests/",
    "lint": "expo lint",
    "seed:sql": "node scripts/write-seed-sql.mjs",
    "test:server": "node --test supabase/tests/",
    "test:app": "jest",
    "legal": "node scripts/make-legal-pages.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/",
      "/supabase/"
    ]
  }
